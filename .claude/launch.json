{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx next build && npx next start -p 3000"
      ],
      "port": 3000
    }
  ]
}
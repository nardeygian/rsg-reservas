# Copia este archivo a .env.local y llena los valores reales.
# Las claves vienen del panel de Supabase: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo se usa del lado servidor (Edge Functions, rutas de Next.js).
# Jamás expongas esta llave al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones por Slack (Fase 1)
# Crea una app en api.slack.com/apps con scopes:
#   chat:write, chat:write.public, im:write, users:read, users:read.email
SLACK_BOT_TOKEN=
# ID del canal staff (formato C0XXXXXX). En Slack: clic derecho sobre el canal → View channel details → Copy channel ID.
SLACK_RESERVAS_CHANNEL_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yuhfntejqkgajmacqmix.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key del proyecto>
SUPABASE_SERVICE_ROLE_KEY=<service role key del proyecto>

# ── URL del sitio (cambiar a la URL real en producción) ────────────────────────
SITE_URL=https://panel.resurgencia.com

# ── Asana (calendario de eventos) ─────────────────────────────────────────────
ASANA_PAT=<personal access token de Asana>
ASANA_CALENDAR_PROJECT_GID=<GID del proyecto de calendario en Asana>

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token del workspace de RSG (Bot Token Scopes: chat:write, im:write, users:read.email)
SLACK_BOT_TOKEN=xoxb-...
# ID del canal donde llegan las notificaciones de reservas (ej. C0123456789)
SLACK_RESERVAS_CHANNEL_ID=C...

# ── Efectivo (Google Sheets → Portal) ─────────────────────────────────────────
# Token secreto compartido entre el Apps Script del Sheet y este servidor.
# Genera uno con: openssl rand -hex 32
# Pega el mismo valor en el Apps Script de la hoja Y aquí.
EFECTIVO_TOKEN=<token-secreto-aleatorio>
